{
  "name": "@kongyo2/yome",
  "version": "1.10.2",
  "description": "Markdown viewer that opens .md files in a browser with live-reload",
  "keywords": [
    "markdown",
    "viewer",
    "preview",
    "browser",
    "live-reload",
    "mermaid",
    "katex",
    "shiki",
    "cli"
  ],
  "homepage": "https://github.com/kongyo2/yome",
  "repository": {
    "type": "git",
    "url": "https://github.com/kongyo2/yome.git"
  },
  "bugs": {
    "url": "https://github.com/kongyo2/yome/issues"
  },
  "author": "k1LoW (original Go implementation), ported to Node.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yome": "dist/bin/yome.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "cd frontend && vite build",
    "build:server": "tsrs -p tsconfig.build.json --noEmit && node scripts/build-server.mjs && node scripts/post-build.mjs",
    "dev": "npm run build:frontend && node --import tsx src/bin/yome.ts --foreground --port 16275",
    "dev:frontend": "cd frontend && vite",
    "test": "vitest run && cd frontend && vitest run",
    "test:server": "vitest run",
    "test:frontend": "cd frontend && vitest run",
    "typecheck": "tsrs --noEmit && cd frontend && tsrs --noEmit",
    "lint": "oxlint --silent",
    "lint:strict": "oxlint --deny-warnings",
    "check:file": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file:fmt": "prettier --check"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "open": "^11.0.4",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
